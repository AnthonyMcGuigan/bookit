{
  "name": "bookit-ios",
  "version": "1.0.0",
  "private": true,
  "description": "BookIt: Wrestling Booking Sim for iPhone (Capacitor shell around the same index.html as the web game)",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "sync": "node scripts/copy-web.mjs && npx cap sync ios",
    "assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#14111c' --splashBackgroundColor '#14111c' --splashBackgroundColorDark '#14111c'",
    "open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/status-bar": "8.0.4",
    "@capacitor/splash-screen": "8.0.2",
    "@revenuecat/purchases-capacitor": "14.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@capacitor/assets": "4.0.0"
  }
}
