# Copy to .env.local and fill in. Placeholder values only; never commit real keys.

# Supabase project (for local development, values come from `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only secret key. Used for media uploads and admin tasks. Never expose to the browser.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Public URL of this app (used in auth email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development-only entitlement switcher (ignored in production unless explicitly allowed).
ENABLE_DEV_ENTITLEMENTS=false
# ALLOW_DEV_ENTITLEMENTS_IN_PRODUCTION=false

# Payment provider. Leave unset: no provider is integrated and nothing can be
# purchased or charged. See docs/billing.md before changing this.
BILLING_PROVIDER=
